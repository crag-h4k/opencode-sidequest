{
  "name": "opencode-sidequest",
  "version": "0.1.0",
  "description": "Agent DAGs for OpenCode V2: a dependency graph of sub-agent steps with a live per-session terminal panel",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crag-h4k/opencode-sidequest.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "dag",
    "agents",
    "workflow",
    "tui"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "rpc.ts",
    "dag.mjs",
    "layout.mjs",
    "panel-state.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "effect": ">=4.0.1 <5",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@opentui/core": "0.6.5",
    "@opentui/solid": "0.6.5",
    "@types/node": "^24.0.0",
    "effect": "4.0.1",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
